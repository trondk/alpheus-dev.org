{{/* One vanity import page per public package (WWW-17). /alpheus/ itself is _index.md. */}}
{{ range hugo.Data.gopackages.packages }}
  {{ $pkg := printf "%s/%s" site.Params.goModule . }}
  {{ $.AddPage (dict
    "kind" "page"
    "path" .
    "title" $pkg
    "layout" "vanity"
    "params" (dict "package" $pkg)
  ) }}
{{ end }}
